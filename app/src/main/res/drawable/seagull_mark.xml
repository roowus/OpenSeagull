<?xml version="1.0" encoding="utf-8"?>
<!-- OpenSeagull's own mark: an original two-stroke gull silhouette, drawn here as vector path
     data. No artwork from OpenPigeon or GamePigeon is used anywhere in this project. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left wing, drawn as a filled crescent so it stays legible when rasterised small. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M18,58 C30,40 42,38 54,52 C42,46 32,50 24,62 Z" />

    <!-- Right wing, mirrored. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M90,58 C78,40 66,38 54,52 C66,46 76,50 84,62 Z" />

</vector>
